{
    "name": "renaud/filament-folio-theme",
    "description": "Thème Filament du panel : coins arrondis, boutons pilule, champs remplis, Albert Sans et Lora.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Renaud\\FilamentFolioTheme\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Renaud\\FilamentFolioTheme\\FolioThemeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
